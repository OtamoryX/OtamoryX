{
  "name": "otamoryx-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OtamoryX digital comic/manga reader and management platform - Frontend",
  "author": "OtamoryX Contributors",
  "license": "GPL-3.0",
  "homepage": "https://github.com/your-username/OtamoryX",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/OtamoryX.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:skip-typecheck": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "tauri": "tauri"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "@tanstack/vue-query": "^5.0.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/tsconfig": "^0.5.0",
    "typescript": "^5.3.0",
    "vue-tsc": "^1.8.25",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^23.0.0",
    "eslint": "^8.56.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "eslint-plugin-vue": "^9.19.2",
    "prettier": "^3.1.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "@headlessui/vue": "^1.7.16",
    "@heroicons/vue": "^2.0.18",
    "@tauri-apps/cli": "^1.5.0",
    "@tauri-apps/api": "^1.5.0"
  }
}